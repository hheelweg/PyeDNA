# %%%%%%%%%%%%%%%%%% PARAMETER file %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# DNA structure
# specify residue sequence and DNA type in data/dna_templates
dna_sequence 		= 	'TGCACTCTCGAATGACCGAGCT'
dna_type		    =	'double_helix'
dna_name		    =	'dna'
# %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# DYE attachment
# specify which dyes/chromophores should be attached and at which residue
dyes			    = 	['CY3', 'CY3', 'CY5']
dye_positions		=	[13, 14, 11]
structure_name		=	'dna_1nt'

